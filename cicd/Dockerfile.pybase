# Base image for SONiC python-repo unit tests (sonic-utilities, snmpagent,
# host-services, dbsyncd, platform-common, platform-daemons). Mirrors the
# dependency-install steps of each repo's azure-pipelines.yml:
#   slave-bookworm + common-libs debs (libnl/libyang3/python3-libyang)
#   + swss-common debs + libdashapi + SONiC wheels from sonic-buildimage.vs
#   + dotnet-sdk-8.0 (utilities/platform-common/snmpagent CI install it).
# Tests then run in FRESH --rm containers from this image (like CI).
ARG DEBIAN=bookworm
FROM sonicdev-microsoft.azurecr.io:443/sonic-slave-${DEBIAN}:latest

COPY debs/ /tmp/debs/
COPY wheels/ /tmp/wheels/

# 1. CI purges the slave's stock libnl dev pkgs before dpkg -i (version clash
#    with common-libs libnl); libyang3 + python3-libyang come from common-libs.
# 2. swss-common + dash-api debs provide libswsscommon / python3-swsscommon / libdashapi.
RUN apt-get update \
 && apt-get install -y python3-pip python3-protobuf python3-yaml python3-requests redis-server \
 && apt-get -y purge libnl-3-dev libnl-route-3-dev || true \
 && dpkg -i /tmp/debs/libnl-3-200_*.deb /tmp/debs/libnl-genl-3-200_*.deb \
             /tmp/debs/libnl-route-3-200_*.deb /tmp/debs/libnl-nf-3-200_*.deb \
 && dpkg -i /tmp/debs/libyang3_*.deb /tmp/debs/libyang-dev_3*.deb /tmp/debs/python3-libyang_*.deb \
 && dpkg -i /tmp/debs/libswsscommon_1.0.0_amd64.deb /tmp/debs/libswsscommon-dev_1.0.0_amd64.deb \
             /tmp/debs/python3-swsscommon_1.0.0_amd64.deb \
 && dpkg -i /tmp/debs/libdashapi_*.deb \
 || (apt-get -y install -f && dpkg -i /tmp/debs/*.deb)

# SONiC python wheels (swsssdk, sonic_py_common, sonic_yang_mgmt/models,
# sonic_config_engine, sonic_platform_common, sonic_utilities) + CI pins.
RUN pip3 install requests==2.31.0 \
 && pip3 install /tmp/wheels/swsssdk-*.whl \
                 /tmp/wheels/sonic_py_common-*.whl \
                 /tmp/wheels/sonic_yang_mgmt-*.whl \
                 /tmp/wheels/sonic_yang_models-*.whl \
                 /tmp/wheels/sonic_config_engine-*.whl \
                 /tmp/wheels/sonic_platform_common-*.whl \
                 /tmp/wheels/sonic_utilities-*.whl \
 && pip3 install enum34

# .NET SDK 8.0 (installed by utilities / platform-common / snmpagent / dbsyncd CI)
RUN curl -sSL https://packages.microsoft.com/keys/microsoft.asc | apt-key add - \
 && apt-add-repository -y https://packages.microsoft.com/debian/12/prod \
 && apt-get update \
 && apt-get install -y dotnet-sdk-8.0 \
 && rm -rf /var/lib/apt/lists/* /tmp/debs /tmp/wheels

CMD ["sleep", "infinity"]
