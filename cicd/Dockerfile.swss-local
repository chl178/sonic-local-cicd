# Local variant of sonic-swss/build-env/Dockerfile: same setup steps, but
# upstream bundles are injected via --upstream-staged-dir (pre-downloaded with
# resumable curl) because in-docker downloads from the Azure artifact CDN
# time out from this network. Keep in sync with the repo Dockerfile when it
# changes; the only intentional diff is the COPY staged/ + the two flags.
ARG DEBIAN=bookworm
ARG BRANCH=master
FROM sonicdev-microsoft.azurecr.io:443/sonic-slave-${DEBIAN}:${BRANCH}

ARG USER
ARG UID
ARG GID
ARG HOME
ARG DEBIAN
ARG BRANCH
ARG SWSS_COMMON_REF=master

RUN groupadd --gid "${GID}" "${USER}" \
 && useradd --gid "${GID}" --uid "${UID}" --create-home --home-dir "${HOME}" --shell /bin/bash "${USER}" \
 && usermod --append --groups sudo "${USER}"
RUN echo "${USER} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USER}" \
 && chmod 0440 "/etc/sudoers.d/${USER}" \
 && sed --in-place -E 's/^#?PermitRootLogin.*$/PermitRootLogin prohibit-password/g' /etc/ssh/sshd_config
RUN echo "* soft nofile 2048" >> /etc/security/limits.conf \
 && mkdir --parents /__w \
 && chown --recursive "${USER}:${USER}" /__w

RUN git clone --depth 1 --branch "${SWSS_COMMON_REF}" \
      https://github.com/sonic-net/sonic-swss-common /tmp/sw-common
COPY packages/ /workspace/build-env/packages/
COPY upstream-artifacts.yaml /workspace/build-env/upstream-artifacts.yaml
COPY custom-setup.sh /tmp/custom-setup.sh
COPY staged/ /staged/

RUN apt-get update \
 && apt-get install -y python3-yaml python3-requests sudo \
 && PYTHONPATH=/tmp/sw-common/ci python3 -m buildenv_setup \
      --repo-dir /workspace \
      --scope build \
      --arch amd64 \
      --debian-version "${DEBIAN}" \
      --branch "${BRANCH}" \
      --org-url https://dev.azure.com/mssonic \
      --no-sudo \
      --upstream-staged-dir /staged \
      --required-staged-upstream common-libs \
      --required-staged-upstream sonic-swss-common \
      --required-staged-upstream sonic-sairedis \
      --required-staged-upstream sonic-dash-api \
      --required-staged-upstream vpp \
 && bash /tmp/custom-setup.sh

USER ${USER}
CMD ["sleep", "infinity"]
